# Compile Clementine
FROM rust:1.97.1-trixie as builder
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake protobuf-compiler pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /clementine
COPY . .
RUN cargo build --release --bin clementine-core --features=automation

FROM debian:trixie-slim
RUN \
  apt-get update \
  && apt -y install gettext-base libssl-dev wget \
  && apt clean \
  && apt install -y --no-install-recommends ca-certificates \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /clementine/target/release/clementine-core /clementine-core

# Set up Clementine
# BitVM script generation needs far more stack than the 2 MiB default. See docs/usage.md.
ENV RUST_MIN_STACK=33554432
ENTRYPOINT [ "/clementine-core" ]
EXPOSE 17000